        </mxCell>
        <mxCell id="l5t" value="Redis provides shared state for SSE pub/sub fan-out and consistent rate limiting." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#16191F;whiteSpace=wrap;" vertex="1" parent="legend-outer">
