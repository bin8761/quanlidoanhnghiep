        </mxCell>
        <mxCell id="l3t" value="Elastic Beanstalk manages two EC2 application instances across private app subnets in two AZs." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#16191F;whiteSpace=wrap;" vertex="1" parent="legend-outer">
