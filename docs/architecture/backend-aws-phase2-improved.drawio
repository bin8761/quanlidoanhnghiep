          <mxGeometry x="20" y="270" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="l4t" value="The application tier uses RDS MySQL Multi-AZ for managed transactional persistence." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#16191F;whiteSpace=wrap;" vertex="1" parent="legend-outer">
