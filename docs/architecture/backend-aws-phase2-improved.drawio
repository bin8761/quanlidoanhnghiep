        <mxCell id="l6t" value="User uploads land in a private S3 bucket and outbound mail goes through Amazon SES." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#16191F;whiteSpace=wrap;" vertex="1" parent="legend-outer">
