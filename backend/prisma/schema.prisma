generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum NotificationType {
  ASSET_ASSIGNED
  ASSET_RETURNED
  ASSET_TRANSFERRED
  MAINTENANCE_CREATED
  MAINTENANCE_UPDATED
}

model Employee {
  id                  String               @id @default(uuid()) @db.Char(36)
  employeeCode        String               @unique @map("employee_code")
  fullName            String               @map("full_name")
  email               String               @unique
  departmentId        Int?                 @map("department_id")
  locationId          Int?                 @map("location_id")
  deskX               Float?               @map("desk_x")
  deskY               Float?               @map("desk_y")
  status              String               @default("ACTIVE")
  avatarUrl           String?              @map("avatar_url") @db.Text
  position            String               @default("Nhân viên") @map("position")
  joinDate            DateTime             @default(now()) @map("join_date")
  phone               String?
  personalEmail       String?              @map("personal_email")
  dateOfBirth         DateTime?            @map("date_of_birth")
  gender              String?
  permanentAddress    String?              @map("permanent_address") @db.Text
  currentAddress      String?              @map("current_address") @db.Text
  emergencyContact    Json?                @map("emergency_contact")
  education           Json?
  skills              Json?
  certificates        Json?
  hometown            String?
  ethnicity           String?
  nationality         String?
  identityCardNumber  String?              @map("identity_card_number")
  allowProfileUpdate  Boolean              @default(true) @map("allow_profile_update")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  user                User?
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  location            Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignments         AssetAssignment[]
  supportRequests     SupportRequest[]
  attachments         EmployeeAttachment[]
  profileLogs         EmployeeProfileLog[]
  managedDepartments  Department[]         @relation("DepartmentManager")
  chatSessions        ChatSession[]

  @@map("employees")
}

model User {
  id                 String    @id @default(uuid()) @db.Char(36)
  employeeId         String?   @unique @map("employee_id") @db.Char(36)
  email              String    @unique
  passwordHash       String    @map("password_hash")
  role               UserRole
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  employee          Employee?          @relation(fields: [employeeId], references: [id])
  passwordResetOtps PasswordResetOtp[]
  notifications     Notification[]
  assignedRequests  SupportRequest[]   @relation("SupportRequestAssignee")
  approvedRequests  SupportRequest[]   @relation("SupportRequestApprover")
  requestEvents     SupportRequestEvent[]
  tasks             UserTask[]
  uploadedAttachments EmployeeAttachment[]
  profileLogs         EmployeeProfileLog[]
  departmentAuditLogs DepartmentAuditLog[]

  @@map("users")
}

model Notification {
  id        String           @id @default(uuid()) @db.Char(36)
  userId    String           @map("user_id") @db.Char(36)
  type      NotificationType
  title     String
  message   String           @db.Text
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model PasswordResetOtp {
  id           String    @id @default(uuid()) @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  otpCodeHash  String    @map("otp_code_hash")
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  verifiedAt   DateTime? @map("verified_at")
  attemptCount Int       @default(0) @map("attempt_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("password_reset_otps")
}

model Department {
  id                Int                @id @default(autoincrement())
  code              String             @unique @db.VarChar(50)
  name              String             @unique
  description       String?            @db.Text
  managerId         String?            @map("manager_id") @db.Char(36)
  email             String?            @db.VarChar(255)
  phone             String?            @db.VarChar(50)
  establishedDate   DateTime?          @map("established_date")
  branch            String?            @db.VarChar(100)
  status            String             @default("ACTIVE")
  parentId          Int?               @map("parent_id")
  annualBudget      Decimal            @default(0.00) @map("annual_budget") @db.Decimal(15, 2)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  employees         Employee[]
  inventorySessions InventorySession[]
  ownedAssets       Asset[]            @relation("AssetOwnerDepartment")
  manager           Employee?          @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  parent            Department?        @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          Department[]       @relation("DepartmentHierarchy")
  quotas            DepartmentAssetQuota[]
  auditLogs         DepartmentAuditLog[]

  @@map("departments")
}

model AssetCategory {
  id               Int                    @id @default(autoincrement())
  name             String                 @unique
  description      String?                @db.Text
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  assets           Asset[]
  departmentQuotas DepartmentAssetQuota[]

  @@map("asset_categories")
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  BROKEN
  LOST
  DISPOSED
}

model Asset {
  id                  String               @id @default(uuid()) @db.Char(36)
  assetCode           String               @unique @map("asset_code")
  name                String
  categoryId          Int                  @map("category_id")
  locationId          Int?                 @map("location_id")
  ownerDepartmentId   Int?                 @map("owner_department_id")
  locationX           Float?               @map("location_x")
  locationY           Float?               @map("location_y")
  serialNumber        String?              @map("serial_number")
  purchaseDate        DateTime?            @map("purchase_date")
  value               Decimal?             @db.Decimal(15, 2)
  status              AssetStatus          @default(AVAILABLE)
  imageUrl            String?              @map("image_url") @db.Text
  notes               String?              @db.Text
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  category            AssetCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location            Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  ownerDepartment     Department?          @relation("AssetOwnerDepartment", fields: [ownerDepartmentId], references: [id], onDelete: SetNull)
  assignments         AssetAssignment[]
  supportRequests      SupportRequest[]
  inventoryItems      InventoryItem[]

  @@index([status, categoryId, ownerDepartmentId, locationId])
  @@map("assets")
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
  TRANSFERRED
}

model AssetAssignment {
  id         String           @id @default(uuid()) @db.Char(36)
  assetId    String           @map("asset_id") @db.Char(36)
  employeeId String           @map("employee_id") @db.Char(36)
  assignedAt DateTime         @default(now()) @map("assigned_at")
  returnedAt DateTime?        @map("returned_at")
  status     AssignmentStatus @default(ACTIVE)
  notes      String?          @db.Text
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  asset      Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([assetId, status])
  @@index([employeeId, status])
  @@index([assignedAt])
  @@map("asset_assignments")
}

enum RequestType {
  INCIDENT
  MAINTENANCE
  NEW_ALLOCATION
  EXCHANGE
  RECALL
  SOFTWARE_INSTALL
  ACCESS_GRANT
  OTHER
}

enum SupportRequestStatus {
  PENDING
  APPROVED
  IN_PROGRESS
  WAITING_USER
  COMPLETED
  REJECTED
  CANCELLED
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
}

enum SupportRequestEventType {
  CREATED
  APPROVED
  ASSIGNED
  STATUS_CHANGED
  ASSET_STATUS_CHANGED
  ASSIGNMENT_CREATED
  ASSIGNMENT_RETURNED
  ASSIGNMENT_TRANSFERRED
  COMPLETED
  REJECTED
  CANCELLED
}

model SupportRequest {
  id            String               @id @default(uuid()) @db.Char(36)
  type          RequestType          @default(MAINTENANCE)
  priority      RequestPriority      @default(MEDIUM)
  assetId       String?              @map("asset_id") @db.Char(36)
  requesterId   String               @map("requester_id") @db.Char(36)
  assigneeId    String?              @map("assignee_id") @db.Char(36)
  approvedById  String?              @map("approved_by_id") @db.Char(36)
  description   String               @db.Text
  status        SupportRequestStatus @default(PENDING)
  repairCost    Decimal?             @map("repair_cost") @db.Decimal(15, 2)
  notes         String?              @db.Text
  resolution    String?              @db.Text
  completedAt   DateTime?            @map("completed_at")
  cancelledAt   DateTime?            @map("cancelled_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  asset         Asset?               @relation(fields: [assetId], references: [id], onDelete: Restrict)
  requester     Employee             @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  assignee      User?                @relation("SupportRequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  approvedBy    User?                @relation("SupportRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  events        SupportRequestEvent[]

  @@index([status, type, priority])
  @@index([requesterId, status])
  @@index([assigneeId, status])
  @@index([assetId, status])
  @@map("maintenance_requests")
}

model SupportRequestEvent {
  id               String                  @id @default(uuid()) @db.Char(36)
  supportRequestId String                  @map("support_request_id") @db.Char(36)
  actorUserId      String?                 @map("actor_user_id") @db.Char(36)
  type             SupportRequestEventType
  message          String                  @db.Text
  metadata         Json?
  createdAt        DateTime                @default(now()) @map("created_at")
  supportRequest   SupportRequest          @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  actorUser        User?                   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([supportRequestId, createdAt])
  @@map("support_request_events")
}

enum InventorySessionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

model InventorySession {
  id           String                 @id @default(uuid()) @db.Char(36)
  name         String
  departmentId Int                    @map("department_id")
  startDate    DateTime               @map("start_date")
  endDate      DateTime?              @map("end_date")
  status       InventorySessionStatus @default(DRAFT)
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  department   Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  items        InventoryItem[]

  @@index([departmentId, status])
  @@map("inventory_sessions")
}

enum InventoryResult {
  OK
  MISSING
  DAMAGED
}

model InventoryItem {
  id         String          @id @default(uuid()) @db.Char(36)
  sessionId  String          @map("session_id") @db.Char(36)
  assetId    String          @map("asset_id") @db.Char(36)
  locationId Int?            @map("location_id")
  locationX  Float?          @map("location_x")
  locationY  Float?          @map("location_y")
  result     InventoryResult @default(OK)
  notes      String?         @db.Text
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  session    InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  asset      Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  location   Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([sessionId, assetId])
  @@index([assetId])
  @@map("inventory_items")
}

model Location {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  description    String?         @db.Text
  floorPlanUrl   String          @map("floor_plan_url") @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  employees      Employee[]
  assets         Asset[]
  inventoryItems InventoryItem[]

  @@map("locations")
}

enum TaskType {
  INVENTORY_CONFIRMATION
  ASSET_RECEIPT_CONFIRMATION
  MAINTENANCE_FEEDBACK
  ASSET_PERIODIC_CHECK
}

enum TaskStatus {
  PENDING
  COMPLETED
  OVERDUE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model UserTask {
  id          String       @id @default(uuid()) @db.Char(36)
  userId      String       @map("user_id") @db.Char(36)
  type        TaskType
  title       String       @db.VarChar(255)
  description String?      @db.Text
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  actionUrl   String       @map("action_url") @db.VarChar(512)
  referenceId String?      @map("reference_id") @db.VarChar(36)
  dueAt       DateTime?    @map("due_at")
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([dueAt, status])
  @@map("user_tasks")
}

model EmployeeAttachment {
  id           String   @id @default(uuid()) @db.Char(36)
  employeeId   String   @map("employee_id") @db.Char(36)
  fileName     String   @map("file_name")
  fileType     String   @map("file_type")
  fileUrl      String   @map("file_url") @db.Text
  uploadedAt   DateTime @default(now()) @map("uploaded_at")
  uploadedById String   @map("uploaded_by_id") @db.Char(36)

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@map("employee_attachments")
}

model EmployeeProfileLog {
  id         String   @id @default(uuid()) @db.Char(36)
  employeeId String   @map("employee_id") @db.Char(36)
  actorId    String   @map("actor_id") @db.Char(36)
  changedAt  DateTime @default(now()) @map("changed_at")
  fieldName  String   @map("field_name")
  oldValue   String?  @db.Text @map("old_value")
  newValue   String?  @db.Text @map("new_value")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  actor    User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@map("employee_profile_logs")
}

model DepartmentAssetQuota {
  id           Int           @id @default(autoincrement())
  departmentId Int           @map("department_id")
  categoryId   Int           @map("category_id")
  maxQuantity  Int           @map("max_quantity")
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  category     AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([departmentId, categoryId])
  @@map("department_asset_quotas")
}

model DepartmentAuditLog {
  id           String     @id @default(uuid()) @db.Char(36)
  departmentId Int        @map("department_id")
  actorId      String     @map("actor_id") @db.Char(36)
  action       String     @db.VarChar(50) // 'CREATE', 'UPDATE', 'DELETE'
  details      String     @db.Text // JSON string containing changes (field, old_value, new_value)
  createdAt    DateTime   @default(now()) @map("created_at")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  actor        User       @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@map("department_audit_logs")
}

model ChatSession {
  id          String        @id @default(uuid()) @db.Char(36)
  employeeId  String        @map("employee_id") @db.Char(36)
  status      String        @default("BOT") // "BOT", "ACTIVE", "CLOSED"
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id         String   @id @default(uuid()) @db.Char(36)
  sessionId  String   @map("session_id") @db.Char(36)
  senderType String   @map("sender_type") // "USER", "BOT", "ADMIN"
  senderId   String?  @map("sender_id") @db.Char(36) // Admin User ID (null for BOT / USER)
  message    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

